// IX-Ray Maya file translator options.
// One file defines the MEL procedures used by both the importers (.object/.ogf)
// and the exporters (.object/.ogf); it is embedded into the plugin and executed on load.
// All widget state is round-tripped through the options string AND stored in
// optionVar so the last used values survive a Maya restart.

global proc int xray_re_object_import_options(string $parent, string $action, string $options, string $callback)
{
	string $smoothing_params[] = { "soc", "cscop", "normals" };
	string $smoothing_names[]  = { "smoothing_soc", "smoothing_cscop", "smoothing_normals" };
	string $smoothing_labels[] = { "SoC", "CS/CoP", "Normals" };
	int $i, $j;

	if ($action == "post")
	{
		setParent $parent;
		columnLayout -adj true;
		text -label "Smoothing:" -align "left";
		radioCollection "smoothing_mode";
		for ($i = 0; $i < size($smoothing_params); $i++)
			radioButton -label $smoothing_labels[$i] $smoothing_names[$i];

		string $smoothing = "normals";
		if (`optionVar -exists "ixrayImportSmoothingMode"`)
			$smoothing = `optionVar -q "ixrayImportSmoothingMode"`;
		for ($i = 0; $i < size($smoothing_params); $i++)
			if ($smoothing_params[$i] == $smoothing)
				radioCollection -edit -select $smoothing_names[$i] "smoothing_mode";

		int $split_parts = 1;
		if (`optionVar -exists "ixrayImportSplitParts"`)
			$split_parts = `optionVar -q "ixrayImportSplitParts"`;
		checkBox -label "Split mesh into parts" -value $split_parts "split_parts";
		int $show_shapes = 1;
		if (`optionVar -exists "ixrayImportShowShapes"`)
			$show_shapes = `optionVar -q "ixrayImportShowShapes"`;
		checkBox -label "Show Collision Shapes" -value $show_shapes "ixray_show_shapes";

		string $params[];
		tokenize($options, ";", $params);
		for ($i = 0; $i < size($params); $i++)
		{
			string $kv[];
			tokenize($params[$i], "=", $kv);
			if (size($kv) < 2)
				continue;

			if ($kv[0] == "split_parts")
				checkBox -edit -value (($kv[1] == "true") ? true : false) "split_parts";

			if ($kv[0] == "smoothing_mode")
				for ($j = 0; $j < size($smoothing_params); $j++)
					if ($smoothing_params[$j] == $kv[1])
						radioCollection -edit -select $smoothing_names[$j] "smoothing_mode";
		}
	}
	else if ($action == "query")
	{
		$options = "";
		optionVar -iv "ixrayImportShowShapes" (`checkBox -q -value "ixray_show_shapes"`);

		if (`checkBox -q -value "split_parts"`)
		{
			$options += "split_parts=true;";
			optionVar -iv "ixrayImportSplitParts" 1;
		}
		else
		{
			$options += "split_parts=false;";
			optionVar -iv "ixrayImportSplitParts" 0;
		}

		string $selected = `radioCollection -q -sl "smoothing_mode"`;
		for ($i = 0; $i < size($smoothing_names); $i++)
		{
			if ($smoothing_names[$i] == $selected)
			{
				$options += "smoothing_mode=" + $smoothing_params[$i] + ";";
				optionVar -sv "ixrayImportSmoothingMode" $smoothing_params[$i];
			}
		}

		eval($callback + " \"" + $options + "\"");
	}

	return 1;
}

global proc int xray_re_ogf_export_options(string $parent, string $action, string $options, string $callback)
{
	string $modes[] = { "soc", "cscop", "normals" };
	string $labels[] = { "SDK SoC (smoothing groups)", "SDK CS/CoP (smooth edges)", "Normals" };
	int $i;
	if ($action == "post") {
		setParent $parent;
		columnLayout -adj true;
		text -label "Smoothing:" -align "left";
		radioCollection "ixrayOgfSmoothing";
		for ($i = 0; $i < 3; ++$i)
			radioButton -label $labels[$i] ("ixrayOgf_" + $modes[$i]);
		string $mode = "normals";
		int $influences = 4;
		if (`optionVar -exists "ixrayOgfSmoothing"`) $mode = `optionVar -q "ixrayOgfSmoothing"`;
		if (`optionVar -exists "ixrayOgfInfluences"`) $influences = `optionVar -q "ixrayOgfInfluences"`;
		string $refs = `ixrayOmfSceneValue "ixrayOgfMotionRefs" ""`;
		string $params[];
		tokenize($options, ";", $params);
		for ($i = 0; $i < size($params); ++$i) {
			string $kv[];
			tokenize($params[$i], "=", $kv);
			if (size($kv) < 2) continue;
			if ($kv[0] == "ogf_smoothing") $mode = $kv[1];
			if ($kv[0] == "ogf_influences") $influences = (int)$kv[1];
			// Scene metadata is authoritative.  The translator can pass an empty
			// transient value here when reopening its option dialog.
			if ($kv[0] == "ogf_motion_refs" && $refs == "") $refs = $kv[1];
		}
		radioCollection -edit -select "ixrayOgf_normals" "ixrayOgfSmoothing";
		for ($i = 0; $i < 3; ++$i)
			if ($mode == $modes[$i]) radioCollection -edit -select ("ixrayOgf_" + $modes[$i]) "ixrayOgfSmoothing";
		optionMenu -label "Maximum bone influences" "ixrayOgfInfluences";
		menuItem -label "2 (SoC / CS / CoP)";
		menuItem -label "4 (CS / CoP / IX-Ray)";
		optionMenu -edit -select (($influences == 2) ? 1 : 2) "ixrayOgfInfluences";
		text -label "OMF references" -align "left";
		textField -width 440 -text $refs -changeCommand "ixrayOgfSaveMotionRefs" -textChangedCommand "ixrayOgfSaveMotionRefs" "ixrayOgfMotionRefs";
	} else if ($action == "query") {
		string $selected = `radioCollection -q -sl "ixrayOgfSmoothing"`;
		string $mode = "normals";
		for ($i = 0; $i < 3; ++$i) if ($selected == ("ixrayOgf_" + $modes[$i])) $mode = $modes[$i];
		int $influences = (`optionMenu -q -select "ixrayOgfInfluences"` == 1) ? 2 : 4;
		string $refs = `textField -q -text "ixrayOgfMotionRefs"`;
		// Forward slashes also avoid MEL escape sequences in the callback string.
		$refs = substituteAllString($refs, "\\", "/");
		if (`gmatch $refs "*\"*"` || `gmatch $refs "*;*"` || `gmatch $refs "*=*"`) {
			error "OMF references cannot contain quotes, semicolons or equals signs.";
			return 0;
		}
		optionVar -sv "ixrayOgfSmoothing" $mode;
		optionVar -iv "ixrayOgfInfluences" $influences;
		fileInfo "ixrayOgfMotionRefs" $refs;
		$options = "ogf_smoothing=" + $mode + ";ogf_influences=" + $influences + ";ogf_motion_refs=" + $refs + ";";
		eval($callback + " \"" + $options + "\"");
	}
	return 1;
}

global proc string ixrayOmfSceneValue(string $key, string $fallback) { string $v[] = `fileInfo -q $key`; return size($v) ? $v[0] : $fallback; }

global proc ixrayOgfSaveMotionRefs() {
	if (!`control -exists ixrayOgfMotionRefs`) return;
	string $refs = `textField -q -text ixrayOgfMotionRefs`;
	$refs = substituteAllString($refs, "\\", "/");
	fileInfo "ixrayOgfMotionRefs" $refs;
}

global int $gIxrayOmfSelectedMark = -1;
global int $gIxrayOmfSelectedMarkParam = -1;

global proc float ixrayOmfMarkLastKey() {
	float $first = `playbackOptions -q -minTime`;
	float $last = `playbackOptions -q -maxTime`;
	return $last - $first + 1.0;
}

global proc ixrayOmfSaveSceneSettings() {
	if (!`control -exists ixrayOmfPositionPrecision`) return;
	int $item = `optionMenu -q -select ixrayOmfPositionPrecision`;
	int $precision = ($item == 2) ? 16 : (($item == 3) ? 32 : 8);
	string $motionName = `textFieldGrp -q -text ixrayOmfMotionName`;
	float $speed = `floatFieldGrp -q -value1 ixrayOmfSpeed`;
	float $accrue = `floatFieldGrp -q -value1 ixrayOmfAccrue`;
	float $falloff = `floatFieldGrp -q -value1 ixrayOmfFalloff`;
	int $stopAtEnd = `checkBox -q -value ixrayOmfStopAtEnd`;
	int $hasMotionMarks = `checkBox -q -value ixrayOmfHasMotionMarks`;
	string $marks = `textField -q -text ixrayOmfMarksData`;
	fileInfo "ixrayOmfPositionPrecision" $precision;
	fileInfo "ixrayOmfMotionName" $motionName;
	fileInfo "ixrayOmfSpeed" $speed;
	fileInfo "ixrayOmfAccrue" $accrue;
	fileInfo "ixrayOmfFalloff" $falloff;
	fileInfo "ixrayOmfStopAtEnd" $stopAtEnd;
	fileInfo "ixrayOmfHasMotionMarks" $hasMotionMarks;
	fileInfo "ixrayOmfMarks" $marks;
}

global proc ixrayOmfMarksEnabledChanged() {
	int $enabled = `checkBox -q -value ixrayOmfHasMotionMarks`;
	frameLayout -e -enable $enabled ixrayOmfMarksFrame;
	ixrayOmfSaveSceneSettings;
}

// A group is stored as "name/start:end|start:end".  Older scenes used ':'
// after the name too, which conflicts with an interval's Start:End separator.
global proc ixrayOmfMarksNormalize() {
	string $raw = `textField -q -text ixrayOmfMarksData`;
	string $groups[]; tokenize($raw, ",", $groups);
	string $output = "";
	int $i, $j;
	for ($i = 0; $i < size($groups); ++$i) {
		string $group = $groups[$i];
		string $slashParts[]; tokenize($group, "/", $slashParts);
		if (size($slashParts) < 2) {
			string $oldParts[]; tokenize($group, ":", $oldParts);
			if (size($oldParts)) {
				$group = $oldParts[0];
				if (size($oldParts) > 1) {
					string $intervals = $oldParts[1];
					for ($j = 2; $j < size($oldParts); ++$j) $intervals += ":" + $oldParts[$j];
					$group += "/" + $intervals;
				}
			}
		}
		$output = ($output == "" ? $group : $output + "," + $group);
	}
	textField -e -text $output ixrayOmfMarksData;
}

global proc ixrayOmfMarksRefresh() {
	global int $gIxrayOmfSelectedMark;
	string $raw = `textField -q -text ixrayOmfMarksData`;
	textScrollList -e -removeAll ixrayOmfMarksList;
	string $items[]; tokenize($raw, ",", $items);
	for ($item in $items) { string $parts[]; tokenize($item, "/", $parts); if (size($parts) >= 1) textScrollList -e -append $parts[0] ixrayOmfMarksList; }
	if ($gIxrayOmfSelectedMark >= size($items)) $gIxrayOmfSelectedMark = -1;
	if ($gIxrayOmfSelectedMark >= 0) textScrollList -e -selectIndexedItem ($gIxrayOmfSelectedMark + 1) ixrayOmfMarksList;
}

global proc ixrayOmfMarkParamsRefresh() {
	global int $gIxrayOmfSelectedMark;
	global int $gIxrayOmfSelectedMarkParam;
	textScrollList -e -removeAll ixrayOmfMarkParamsList;
	textScrollList -e -enable ($gIxrayOmfSelectedMark >= 0) ixrayOmfMarkParamsList;
	button -e -enable ($gIxrayOmfSelectedMark >= 0) ixrayOmfMarkParamAdd;
	button -e -enable ($gIxrayOmfSelectedMark >= 0 && $gIxrayOmfSelectedMarkParam >= 0) ixrayOmfMarkParamDelete;
	floatField -e -enable ($gIxrayOmfSelectedMark >= 0 && $gIxrayOmfSelectedMarkParam >= 0) ixrayOmfMarkStart;
	floatField -e -enable false ixrayOmfMarkEnd;
	if ($gIxrayOmfSelectedMark < 0) return;
	string $raw = `textField -q -text ixrayOmfMarksData`;
	string $items[]; tokenize($raw, ",", $items);
	if ($gIxrayOmfSelectedMark >= size($items)) return;
	string $parts[]; tokenize($items[$gIxrayOmfSelectedMark], "/", $parts);
	if (size($parts) < 2) return;
	string $intervals[]; tokenize($parts[1], "|", $intervals);
	int $i;
	for ($i = 0; $i < size($intervals); ++$i) textScrollList -e -append ($gIxrayOmfSelectedMark + "_mark" + $i) ixrayOmfMarkParamsList;
	if ($gIxrayOmfSelectedMarkParam >= size($intervals)) $gIxrayOmfSelectedMarkParam = -1;
	if ($gIxrayOmfSelectedMarkParam >= 0) textScrollList -e -selectIndexedItem ($gIxrayOmfSelectedMarkParam + 1) ixrayOmfMarkParamsList;
}

global proc ixrayOmfMarksSelect() {
	global int $gIxrayOmfSelectedMark;
	global int $gIxrayOmfSelectedMarkParam;
	int $selected[] = `textScrollList -q -selectIndexedItem ixrayOmfMarksList`;
	// Maya changes the list selection before the Start field loses focus.  Save
	// the previous interval first so its value cannot be written into the newly
	// selected mark.
	ixrayOmfMarkParamStore;
	$gIxrayOmfSelectedMark = size($selected) ? $selected[0] - 1 : -1;
	$gIxrayOmfSelectedMarkParam = -1;
	ixrayOmfMarkParamsRefresh;
}

global proc ixrayOmfMarkParamsSelect() {
	global int $gIxrayOmfSelectedMark;
	global int $gIxrayOmfSelectedMarkParam;
	int $selected[] = `textScrollList -q -selectIndexedItem ixrayOmfMarkParamsList`;
	int $newParam = size($selected) ? $selected[0] - 1 : -1;
	if ($newParam != $gIxrayOmfSelectedMarkParam) ixrayOmfMarkParamStore;
	$gIxrayOmfSelectedMarkParam = $newParam;
	ixrayOmfMarkParamsRefresh;
	if ($gIxrayOmfSelectedMark < 0 || $gIxrayOmfSelectedMarkParam < 0) return;
	string $raw = `textField -q -text ixrayOmfMarksData`;
	string $groups[]; tokenize($raw, ",", $groups);
	string $parts[]; tokenize($groups[$gIxrayOmfSelectedMark], "/", $parts);
	string $intervals[]; tokenize($parts[1], "|", $intervals);
	string $values[]; tokenize($intervals[$gIxrayOmfSelectedMarkParam], ":", $values);
	if (size($values) == 2) {
		float $start = (float)$values[0] * 30.0;
		float $end = ixrayOmfMarkLastKey();
		floatField -e -value $start ixrayOmfMarkStart;
		floatField -e -value $end ixrayOmfMarkEnd;
	}
}

global proc ixrayOmfMarkParamStore() {
	global int $gIxrayOmfSelectedMark;
	global int $gIxrayOmfSelectedMarkParam;
	if ($gIxrayOmfSelectedMark < 0 || $gIxrayOmfSelectedMarkParam < 0) return;
	float $start = `floatField -q -value ixrayOmfMarkStart`;
	float $end = `floatField -q -value ixrayOmfMarkEnd`;
	$end = ixrayOmfMarkLastKey();
	if ($end < $start) { warning "Motion mark start must not be later than the last scene key."; return; }
	$start /= 30.0;
	$end /= 30.0;
	string $raw = `textField -q -text ixrayOmfMarksData`;
	string $groups[]; tokenize($raw, ",", $groups);
	string $parts[]; tokenize($groups[$gIxrayOmfSelectedMark], "/", $parts);
	string $intervals[]; tokenize($parts[1], "|", $intervals);
	$intervals[$gIxrayOmfSelectedMarkParam] = $start + ":" + $end;
	string $newIntervals = ""; int $i;
	for ($i = 0; $i < size($intervals); ++$i) $newIntervals = ($newIntervals == "" ? $intervals[$i] : $newIntervals + "|" + $intervals[$i]);
	$groups[$gIxrayOmfSelectedMark] = $parts[0] + "/" + $newIntervals;
	string $output = "";
	for ($i = 0; $i < size($groups); ++$i) $output = ($output == "" ? $groups[$i] : $output + "," + $groups[$i]);
	textField -e -text $output ixrayOmfMarksData;
	ixrayOmfSaveSceneSettings;
}

global proc ixrayOmfMarksAdd() {
	global int $gIxrayOmfSelectedMark;
	global int $gIxrayOmfSelectedMarkParam;
	string $result = `confirmDialog -title "Add motion mark" -message "Select mark type" -button "left" -button "left2" -button "right" -button "right2" -button "mm_unpend" -button "Cancel" -defaultButton "left" -cancelButton "Cancel" -dismissString "Cancel"`;
	if ($result != "Cancel") { string $old = `textField -q -text ixrayOmfMarksData`; textField -e -text ($old == "" ? $result : ($old + "," + $result)) ixrayOmfMarksData; $gIxrayOmfSelectedMark = size(`textScrollList -q -allItems ixrayOmfMarksList`); $gIxrayOmfSelectedMarkParam = -1; ixrayOmfMarksRefresh; ixrayOmfMarkParamsRefresh; ixrayOmfSaveSceneSettings; }
}
global proc ixrayOmfMarksDelete() {
	global int $gIxrayOmfSelectedMark;
	global int $gIxrayOmfSelectedMarkParam;
	int $selected[] = `textScrollList -q -selectIndexedItem ixrayOmfMarksList`;
	if (size($selected)) $gIxrayOmfSelectedMark = $selected[0] - 1;
	if ($gIxrayOmfSelectedMark < 0) return;
	string $raw = `textField -q -text ixrayOmfMarksData`;
	string $groups[]; tokenize($raw, ",", $groups);
	string $result = ""; int $i;
	for ($i = 0; $i < size($groups); ++$i) if ($i != $gIxrayOmfSelectedMark) $result = ($result == "" ? $groups[$i] : $result + "," + $groups[$i]);
	textField -e -text $result ixrayOmfMarksData; $gIxrayOmfSelectedMark = -1; $gIxrayOmfSelectedMarkParam = -1; ixrayOmfMarksRefresh; ixrayOmfMarkParamsRefresh; ixrayOmfSaveSceneSettings;
}

global proc ixrayOmfMarkParamAdd() {
	global int $gIxrayOmfSelectedMark;
	global int $gIxrayOmfSelectedMarkParam;
	// Commit the current interval before adding another one.  The Add button
	// takes focus away from Start before Maya emits its normal field event.
	ixrayOmfMarkParamStore;
	int $selected[] = `textScrollList -q -selectIndexedItem ixrayOmfMarksList`;
	if (size($selected)) $gIxrayOmfSelectedMark = $selected[0] - 1;
	if ($gIxrayOmfSelectedMark < 0) return;
	string $raw = `textField -q -text ixrayOmfMarksData`;
	string $groups[]; tokenize($raw, ",", $groups);
	string $parts[]; tokenize($groups[$gIxrayOmfSelectedMark], "/", $parts);
	string $intervals = size($parts) > 1 ? $parts[1] : "";
	float $end = ixrayOmfMarkLastKey() / 30.0;
	$intervals = ($intervals == "" ? "0:" + $end : $intervals + "|0:" + $end);
	$groups[$gIxrayOmfSelectedMark] = $parts[0] + "/" + $intervals;
	string $output = ""; int $i;
	for ($i = 0; $i < size($groups); ++$i) $output = ($output == "" ? $groups[$i] : $output + "," + $groups[$i]);
	textField -e -text $output ixrayOmfMarksData; $gIxrayOmfSelectedMarkParam = size(`textScrollList -q -allItems ixrayOmfMarkParamsList`); ixrayOmfMarkParamsRefresh; ixrayOmfMarkParamsSelect; ixrayOmfSaveSceneSettings;
}

global proc ixrayOmfMarkParamDelete() {
	global int $gIxrayOmfSelectedMark;
	global int $gIxrayOmfSelectedMarkParam;
	int $selectedMark[] = `textScrollList -q -selectIndexedItem ixrayOmfMarksList`;
	int $selectedParam[] = `textScrollList -q -selectIndexedItem ixrayOmfMarkParamsList`;
	if (size($selectedMark)) $gIxrayOmfSelectedMark = $selectedMark[0] - 1;
	if (size($selectedParam)) $gIxrayOmfSelectedMarkParam = $selectedParam[0] - 1;
	if ($gIxrayOmfSelectedMark < 0 || $gIxrayOmfSelectedMarkParam < 0) return;
	string $raw = `textField -q -text ixrayOmfMarksData`;
	string $groups[]; tokenize($raw, ",", $groups);
	string $parts[]; tokenize($groups[$gIxrayOmfSelectedMark], "/", $parts);
	string $intervals[]; tokenize($parts[1], "|", $intervals);
	string $newIntervals = ""; int $i;
	for ($i = 0; $i < size($intervals); ++$i) if ($i != $gIxrayOmfSelectedMarkParam) $newIntervals = ($newIntervals == "" ? $intervals[$i] : $newIntervals + "|" + $intervals[$i]);
	$groups[$gIxrayOmfSelectedMark] = $parts[0] + "/" + $newIntervals;
	string $output = "";
	for ($i = 0; $i < size($groups); ++$i) $output = ($output == "" ? $groups[$i] : $output + "," + $groups[$i]);
	textField -e -text $output ixrayOmfMarksData; $gIxrayOmfSelectedMarkParam = -1; ixrayOmfMarkParamsRefresh; ixrayOmfSaveSceneSettings;
}

// OMF playback speed is expressed relative to the engine's base rate of 30 FPS.
// Maya returns named units (film, ntsc, ...) or a value such as "120fps".
global proc float ixrayOmfCurrentFps() {
	string $unit = `currentUnit -query -time`;
	if ($unit == "game") return 15.0;
	if ($unit == "film") return 24.0;
	if ($unit == "pal") return 25.0;
	if ($unit == "ntsc") return 30.0;
	if ($unit == "show") return 48.0;
	if ($unit == "palf") return 50.0;
	if ($unit == "ntscf") return 60.0;
	if (`gmatch $unit "*fps"`) {
		string $fpsText = substituteAllString($unit, "fps", "");
		float $fps = (float)$fpsText;
		if ($fps > 0.0) return $fps;
	}
	return 30.0;
}

global proc int xray_re_omf_export_options(string $parent, string $action, string $options, string $callback)
{
	if ($action == "post") {
		setParent $parent;
		columnLayout -adj true;
		text -label "Skeletal OMF: exports the current Maya timeline as one motion." -align "left";
		int $precision = 32;
		string $motionName = "";
		float $speed = 1.0;
		float $accrue = 2.0;
		float $falloff = 2.0;
		int $stopAtEnd = 0;
		int $hasMotionMarks = 0;
		string $marks = `ixrayOmfSceneValue "ixrayOmfMarks" ""`;
		string $scenePath = `file -q -sn`;
		$precision = (int)`ixrayOmfSceneValue "ixrayOmfPositionPrecision" "32"`;
		$motionName = `ixrayOmfSceneValue "ixrayOmfMotionName" ""`;
		// The speed must always match the current scene frame rate.
		$speed = ixrayOmfCurrentFps() / 30.0;
		$accrue = (float)`ixrayOmfSceneValue "ixrayOmfAccrue" "2"`;
		$falloff = (float)`ixrayOmfSceneValue "ixrayOmfFalloff" "2"`;
		$stopAtEnd = (int)`ixrayOmfSceneValue "ixrayOmfStopAtEnd" "0"`;
		$hasMotionMarks = (int)`ixrayOmfSceneValue "ixrayOmfHasMotionMarks" "0"`;
		string $params[];
		tokenize($options, ";", $params);
		int $i;
		for ($i = 0; $i < size($params); ++$i) {
			string $kv[];
			tokenize($params[$i], "=", $kv);
			if ($scenePath != "" && size($kv) >= 2 && $kv[0] == "omf_position_precision") $precision = (int)$kv[1];
			if ($scenePath != "" && size($kv) >= 2 && $kv[0] == "omf_motion_name") $motionName = $kv[1];
			if ($scenePath != "" && size($kv) >= 2 && $kv[0] == "omf_speed") $speed = (float)$kv[1];
			if ($scenePath != "" && size($kv) >= 2 && $kv[0] == "omf_accrue") $accrue = (float)$kv[1];
			if ($scenePath != "" && size($kv) >= 2 && $kv[0] == "omf_falloff") $falloff = (float)$kv[1];
			if ($scenePath != "" && size($kv) >= 2 && $kv[0] == "omf_stop_at_end") $stopAtEnd = ($kv[1] == "true");
			if ($scenePath != "" && size($kv) >= 2 && $kv[0] == "omf_has_motion_marks") $hasMotionMarks = ($kv[1] == "true");
		}
		optionMenu -label "Position key precision" -changeCommand "ixrayOmfSaveSceneSettings" "ixrayOmfPositionPrecision";
		menuItem -label "8 bit";
		menuItem -label "16 bit";
		menuItem -label "32 bit";
		optionMenu -edit -select (($precision == 16) ? 2 : (($precision == 32) ? 3 : 1)) "ixrayOmfPositionPrecision";
		textFieldGrp -label "Motion name" -text $motionName -changeCommand "ixrayOmfSaveSceneSettings" "ixrayOmfMotionName";
		text -label "Empty: use the OMF file name without extension." -align "left";
		rowLayout -numberOfColumns 2 -columnWidth 1 220 -columnWidth 2 160;
		floatFieldGrp -numberOfFields 1 -label "Speed" -value1 $speed -changeCommand "ixrayOmfSaveSceneSettings" "ixrayOmfSpeed";
		checkBox -label "Stop at end" -value $stopAtEnd -changeCommand "ixrayOmfSaveSceneSettings" "ixrayOmfStopAtEnd";
		setParent ..;
		rowLayout -numberOfColumns 2 -columnWidth 1 220 -columnWidth 2 160;
		floatFieldGrp -numberOfFields 1 -label "Accrue" -value1 $accrue -changeCommand "ixrayOmfSaveSceneSettings" "ixrayOmfAccrue";
		checkBox -label "Has Motion Marks" -value $hasMotionMarks -changeCommand "ixrayOmfMarksEnabledChanged" "ixrayOmfHasMotionMarks";
		setParent ..;
		floatFieldGrp -numberOfFields 1 -label "Falloff" -value1 $falloff -changeCommand "ixrayOmfSaveSceneSettings" "ixrayOmfFalloff";
		textField -visible false -text $marks "ixrayOmfMarksData";
		ixrayOmfMarksNormalize;
		frameLayout -label "Motion Marks" -collapsable false -enable $hasMotionMarks "ixrayOmfMarksFrame";
		rowLayout -numberOfColumns 3 -columnWidth 1 180 -columnWidth 2 180 -columnWidth 3 220;
		columnLayout -adj true;
		text -label "Mark" -align "left";
		textScrollList -width 176 -height 68 -allowMultiSelection false -selectCommand "ixrayOmfMarksSelect" "ixrayOmfMarksList";
		rowLayout -numberOfColumns 2 -adjustableColumn 1;
		button -label "Add" -command "ixrayOmfMarksAdd";
		button -label "Delete" -command "ixrayOmfMarksDelete";
		setParent ..;
		setParent ..;
		columnLayout -adj true;
		text -label "Mark Param" -align "left";
		textScrollList -width 176 -height 68 -allowMultiSelection false -enable false -selectCommand "ixrayOmfMarkParamsSelect" "ixrayOmfMarkParamsList";
		rowLayout -numberOfColumns 2 -adjustableColumn 1;
		button -label "Add" -enable false -command "ixrayOmfMarkParamAdd" "ixrayOmfMarkParamAdd";
		button -label "Delete" -enable false -command "ixrayOmfMarkParamDelete" "ixrayOmfMarkParamDelete";
		setParent ..;
		setParent ..;
		columnLayout -adj true;
		text -label "Mark settings" -align "left";
		text -label "Keys" -align "left";
		rowLayout -numberOfColumns 2 -columnWidth 1 45 -columnWidth 2 160;
		text -label "Start" -align "left";
		floatField -width 160 -precision 3 -enable false -enterCommand "ixrayOmfMarkParamStore" "ixrayOmfMarkStart";
		setParent ..;
		rowLayout -numberOfColumns 2 -columnWidth 1 45 -columnWidth 2 160;
		text -label "End" -align "left";
		floatField -width 160 -precision 3 -enable false "ixrayOmfMarkEnd";
		setParent ..;
		setParent ..;
		setParent ..;
		ixrayOmfMarksRefresh;
		ixrayOmfMarkParamsRefresh;
	} else if ($action == "query") {
		// The options callback can run before Maya sends a change event for a field
		// that still has keyboard focus, so commit the selected mark explicitly.
		ixrayOmfMarkParamStore;
		int $item = `optionMenu -q -select "ixrayOmfPositionPrecision"`;
		int $precision = ($item == 2) ? 16 : (($item == 3) ? 32 : 8);
		string $motionName = `textFieldGrp -q -text "ixrayOmfMotionName"`;
		float $speed = ixrayOmfCurrentFps() / 30.0;
		float $accrue = `floatFieldGrp -q -value1 "ixrayOmfAccrue"`;
		float $falloff = `floatFieldGrp -q -value1 "ixrayOmfFalloff"`;
		int $stopAtEnd = `checkBox -q -value "ixrayOmfStopAtEnd"`;
		int $hasMotionMarks = `checkBox -q -value "ixrayOmfHasMotionMarks"`;
		string $marks = `textField -q -text "ixrayOmfMarksData"`;
		if (`gmatch $motionName "*\"*"` || `gmatch $motionName "*;*"` || `gmatch $motionName "*=*"`) {
			error "Motion name cannot contain quotes, semicolons or equals signs.";
			return 0;
		}
		fileInfo "ixrayOmfPositionPrecision" $precision; fileInfo "ixrayOmfMotionName" $motionName; fileInfo "ixrayOmfSpeed" $speed; fileInfo "ixrayOmfAccrue" $accrue; fileInfo "ixrayOmfFalloff" $falloff; fileInfo "ixrayOmfStopAtEnd" $stopAtEnd; fileInfo "ixrayOmfHasMotionMarks" $hasMotionMarks; fileInfo "ixrayOmfMarks" $marks;
		eval($callback + " \"omf_position_precision=" + $precision + ";omf_motion_name=" + $motionName + ";omf_speed=" + $speed + ";omf_accrue=" + $accrue + ";omf_falloff=" + $falloff + ";omf_stop_at_end=" + ($stopAtEnd ? "true" : "false") + ";omf_has_motion_marks=" + ($hasMotionMarks ? "true" : "false") + ";omf_marks=" + $marks + ";\"");
	}
	return 1;
}

global proc int xray_re_object_export_options(string $parent, string $action, string $options, string $callback)
{
	string $sdk_ver_params[] = { "1850", "0.4", "0.6" };
	string $sdk_ver_names[]  = { "ver_1850", "ver_0_4", "ver_0_6" };
	string $sdk_ver_labels[] = { "1850", "SoC", "CS/CoP" };
	int $i, $j;

	if ($action == "post")
	{
		setParent $parent;
		columnLayout -adj true;
		int $skeletal = `gmatch $options "*skeletal=true*"`;

		text -label "Target version:";

		radioCollection "sdk_ver";
		for ($i = 0; $i < size($sdk_ver_params); $i++)
			radioButton -label $sdk_ver_labels[$i] $sdk_ver_names[$i];
		radioButton -label "Normals" "ver_normals";

		string $sdk_version = "";
		if (`optionVar -exists "ixrayExportSdkVersion"`)
			$sdk_version = `optionVar -q "ixrayExportSdkVersion"`;
		for ($j = 0; $j < size($sdk_ver_params); $j++)
			if ($sdk_ver_params[$j] == $sdk_version)
				radioCollection -edit -select $sdk_ver_names[$j] "sdk_ver";

		checkBox -label "Compressed" "compressed";
		if ($skeletal) {
			int $influences = 4;
			if (`optionVar -exists "ixraySklObjectInfluences"`)
				$influences = `optionVar -q "ixraySklObjectInfluences"`;
			optionMenu -label "Maximum bone influences" "ixraySklObjectInfluences";
			menuItem -label "2 (SoC / CS / CoP)";
			menuItem -label "4 (CS / CoP / IX-Ray)";
			optionMenu -edit -select (($influences == 2) ? 1 : 2) "ixraySklObjectInfluences";
		}

		int $compressed = 0;
		if (`optionVar -exists "ixrayExportCompressed"`)
			$compressed = `optionVar -q "ixrayExportCompressed"`;
		checkBox -edit -value ($compressed != 0) "compressed";

		int $vnormals = 0;
		if (`optionVar -exists "ixrayExportVNormals"`)
			$vnormals = `optionVar -q "ixrayExportVNormals"`;

		string $params[];
		tokenize($options, ";", $params);
		for ($i = 0; $i < size($params); $i++)
		{
			string $kv[];
			tokenize($params[$i], "=", $kv);
			if (size($kv) < 2)
				continue;

			if ($kv[0] == "sdk_ver")
				for ($j = 0; $j < size($sdk_ver_params); $j++)
					if ($sdk_ver_params[$j] == $kv[1])
						radioCollection -edit -select $sdk_ver_names[$j] "sdk_ver";

			if ($kv[0] == "compressed")
				checkBox -edit -value (($kv[1] == "true") ? true : false) "compressed";

			if ($kv[0] == "vnormals")
				$vnormals = (($kv[1] == "true") ? 1 : 0);
		}
		if ($vnormals)
			radioCollection -edit -select "ver_normals" "sdk_ver";
	}
	else if ($action == "query")
	{
		int $skeletal = `gmatch $options "*skeletal=true*"`;
		$options = "";
		if ($skeletal) {
			int $influences = (`optionMenu -q -select "ixraySklObjectInfluences"` == 1) ? 2 : 4;
			$options += "skeletal=true;skl_influences=" + $influences + ";";
			optionVar -iv "ixraySklObjectInfluences" $influences;
		}

		string $sdk_version = `radioCollection -q -sl "sdk_ver"`;
		int $vnormals = ($sdk_version == "ver_normals");
		for ($i = 0; $i < size($sdk_ver_names); $i++)
		{
			if ($sdk_ver_names[$i] == $sdk_version)
			{
				$options += "sdk_ver=" + $sdk_ver_params[$i] + ";";
				optionVar -sv "ixrayExportSdkVersion" $sdk_ver_params[$i];
			}
		}

		if (`checkBox -q -value "compressed"`)
		{
			$options += "compressed=true;";
			optionVar -iv "ixrayExportCompressed" 1;
		}
		else
		{
			$options += "compressed=false;";
			optionVar -iv "ixrayExportCompressed" 0;
		}

		if ($vnormals)
		{
			$options += "vnormals=true;";
			optionVar -iv "ixrayExportVNormals" 1;
		}
		else
		{
			$options += "vnormals=false;";
			optionVar -iv "ixrayExportVNormals" 0;
		}

		eval($callback + " \"" + $options + "\"");
	}

	return 1;
}
